{
  "entities": {
    "QuoteRequest": {
      "title": "QuoteRequest",
      "description": "Customer fence and gate quote requests and site survey estimates",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "customerName": {
          "type": "string"
        },
        "email": {
          "type": "string",
          "format": "email"
        },
        "phone": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "fenceType": {
          "type": "string"
        },
        "linearFeet": {
          "type": "number"
        },
        "gateType": {
          "type": "string"
        },
        "estimatedCost": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["pending", "contacted", "scheduled", "completed"]
        },
        "notes": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["customerName", "email", "fenceType", "linearFeet"]
    },
    "JobSchedule": {
      "title": "JobSchedule",
      "description": "Scheduled residential fence installations and gate maintenance visits",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "customerName": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "jobType": {
          "type": "string",
          "enum": ["fence_install", "gate_install", "gate_maintenance", "warranty_service", "site_survey"]
        },
        "date": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["upcoming", "in_progress", "completed", "cancelled"]
        },
        "notes": {
          "type": "string"
        }
      },
      "required": ["title", "customerName", "jobType", "date"]
    },
    "WarrantyRecord": {
      "title": "WarrantyRecord",
      "description": "Registered 5-10 year residential fence and gate warranties",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "customerName": {
          "type": "string"
        },
        "address": {
          "type": "string"
        },
        "installDate": {
          "type": "string"
        },
        "warrantyType": {
          "type": "string"
        },
        "warrantyDurationYears": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["active", "expired", "claimed"]
        }
      },
      "required": ["customerName", "address", "installDate", "warrantyType"]
    },
    "MailQueue": {
      "title": "MailQueue",
      "description": "Outbound email trigger queue processed by Firebase Trigger Email extensions",
      "type": "object",
      "properties": {
        "to": {
          "type": "array",
          "description": "List of recipient email addresses"
        },
        "message": {
          "type": "object",
          "description": "Email subject, plain text, and HTML body contents"
        },
        "quoteId": {
          "type": "string"
        },
        "recipientEmail": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["to", "message"]
    },
    "ClientReview": {
      "title": "ClientReview",
      "description": "Verified client testimonials and project satisfaction scores for 208 Fence & Gate installations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "clientName": {
          "type": "string"
        },
        "location": {
          "type": "string"
        },
        "projectType": {
          "type": "string"
        },
        "rating": {
          "type": "number"
        },
        "satisfactionScore": {
          "type": "number"
        },
        "reviewText": {
          "type": "string"
        },
        "completionDate": {
          "type": "string"
        },
        "verifiedHomeowner": {
          "type": "boolean"
        },
        "linearFeet": {
          "type": "number"
        },
        "craftsmanshipHighlights": {
          "type": "array"
        },
        "serviceCategory": {
          "type": "string",
          "enum": ["wood_fence", "vinyl_fence", "automated_gate", "iron_fence", "software"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["clientName", "location", "projectType", "rating", "satisfactionScore", "reviewText"]
    },
    "ProjectGalleryItem": {
      "title": "ProjectGalleryItem",
      "description": "Completed fence, gate, and access control project photos with source links (Firebase Storage, Google Drive, Google Photos)",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "category": { "type": "string" },
        "categoryLabel": { "type": "string" },
        "location": { "type": "string" },
        "linearFeet": { "type": "number" },
        "imageUrl": { "type": "string" },
        "source": { "type": "string", "enum": ["firebase_storage", "google_drive", "google_photos", "verified_install"] },
        "sourceLabel": { "type": "string" },
        "storagePath": { "type": "string" },
        "googleFileId": { "type": "string" },
        "description": { "type": "string" },
        "specs": { "type": "object" },
        "tags": { "type": "array" },
        "aspectRatio": { "type": "string", "enum": ["tall", "wide", "square"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "category", "location", "imageUrl", "source"]
    }
  },
  "firestore": {
    "/quotes/{quoteId}": {
      "schema": "QuoteRequest",
      "description": "Client fence and automated gate quotes submitted online"
    },
    "/schedules/{scheduleId}": {
      "schema": "JobSchedule",
      "description": "Contractor and installation project schedules"
    },
    "/warranties/{warrantyId}": {
      "schema": "WarrantyRecord",
      "description": "Registered customer craftsmanship warranties"
    },
    "/mail/{mailId}": {
      "schema": "MailQueue",
      "description": "Email notifications dispatched via Firebase Trigger Email extension"
    },
    "/reviews/{reviewId}": {
      "schema": "ClientReview",
      "description": "Client project satisfaction reviews and ratings stored in Firestore"
    },
    "/project_gallery/{galleryId}": {
      "schema": "ProjectGalleryItem",
      "description": "Completed project showcase photos synced with Firebase Storage and Google Workspace"
    }
  }
}
